fail() { printf '%s\n' "Kaneo current backup BLOCKED: $*" >&2; exit 2; }
[ "$(id -u)" -eq 0 ] || fail 'root execution required'
[ -f "$PROJECT_BACKUP" ] && [ ! -L "$PROJECT_BACKUP" ] || fail 'production backup wrapper missing or symlinked'
wrapper_hash=$(sha256sum "$PROJECT_BACKUP" | awk '{print $1}')
case "$wrapper_hash" in
    "$EXPECTED_BASELINE_BACKUP_SHA256") expected_compose=$BASELINE_COMPOSE_SHA256; expected_image=$BASELINE_IMAGE ;;
    "$EXPECTED_PREVIOUS_CANDIDATE_BACKUP_SHA256") expected_compose=$PREVIOUS_CANDIDATE_COMPOSE_SHA256; expected_image=$PREVIOUS_CANDIDATE_IMAGE ;;
    "$EXPECTED_CANDIDATE_BACKUP_SHA256") expected_compose=$CANDIDATE_COMPOSE_SHA256; expected_image=$CANDIDATE_IMAGE ;;
    "$EXPECTED_PRE_REPAIR_CANDIDATE_BACKUP_SHA256") expected_compose=$PRE_REPAIR_CANDIDATE_COMPOSE_SHA256; expected_image=$PRE_REPAIR_CANDIDATE_IMAGE ;;
    "$EXPECTED_PREVIOUS_CURRENT_CANDIDATE_BACKUP_SHA256") expected_compose=$PREVIOUS_CURRENT_CANDIDATE_COMPOSE_SHA256; expected_image=$PREVIOUS_CURRENT_CANDIDATE_IMAGE ;;
    "$EXPECTED_CURRENT_CANDIDATE_BACKUP_SHA256") expected_compose=$CURRENT_CANDIDATE_COMPOSE_SHA256; expected_image=$CURRENT_CANDIDATE_IMAGE ;;
    "$EXPECTED_FOLLOWUP_CANDIDATE_BACKUP_SHA256") expected_compose=$FOLLOWUP_CANDIDATE_COMPOSE_SHA256; expected_image=$FOLLOWUP_CANDIDATE_IMAGE ;;
    "$EXPECTED_NEXT_CANDIDATE_BACKUP_SHA256") expected_compose=$NEXT_CANDIDATE_COMPOSE_SHA256; expected_image=$NEXT_CANDIDATE_IMAGE ;;
    "$EXPECTED_VERSION_FIX_CANDIDATE_BACKUP_SHA256") expected_compose=$VERSION_FIX_CANDIDATE_COMPOSE_SHA256; expected_image=$VERSION_FIX_CANDIDATE_IMAGE ;;
    "$EXPECTED_EXECUTION_FLAGS_CANDIDATE_BACKUP_SHA256") expected_compose=$EXECUTION_FLAGS_CANDIDATE_COMPOSE_SHA256; expected_image=$EXECUTION_FLAGS_CANDIDATE_IMAGE ;;
    "$EXPECTED_EXECUTION_SCHEMA_REPAIR_CANDIDATE_BACKUP_SHA256") expected_compose=$EXECUTION_SCHEMA_REPAIR_CANDIDATE_COMPOSE_SHA256; expected_image=$EXECUTION_SCHEMA_REPAIR_CANDIDATE_IMAGE ;;
    "$NATIVE_CONTROL_CANDIDATE_BACKUP_SHA256") expected_compose=$NATIVE_CONTROL_CANDIDATE_COMPOSE_SHA256; expected_image=$NATIVE_CONTROL_CANDIDATE_IMAGE ;;
    "$AUTH_SCOPE_CANDIDATE_BACKUP_SHA256") expected_compose=$AUTH_SCOPE_CANDIDATE_COMPOSE_SHA256; expected_image=$AUTH_SCOPE_CANDIDATE_IMAGE ;;
    "$SUPERVISOR_AUTH_CANDIDATE_BACKUP_SHA256") expected_compose=$SUPERVISOR_AUTH_CANDIDATE_COMPOSE_SHA256; expected_image=$SUPERVISOR_AUTH_CANDIDATE_IMAGE ;;
    "$SUPERVISOR_PRINCIPAL_CANDIDATE_BACKUP_SHA256") expected_compose=$SUPERVISOR_PRINCIPAL_CANDIDATE_COMPOSE_SHA256; expected_image=$SUPERVISOR_PRINCIPAL_CANDIDATE_IMAGE ;;
    "$SUPERVISOR_TERMINAL_GUARD_CANDIDATE_BACKUP_SHA256") expected_compose=$SUPERVISOR_TERMINAL_GUARD_CANDIDATE_COMPOSE_SHA256; expected_image=$SUPERVISOR_TERMINAL_GUARD_CANDIDATE_IMAGE ;;
    "$EXPECTED_CONTROL_ACTOR_CANDIDATE_BACKUP_SHA256") expected_compose=$CONTROL_ACTOR_CANDIDATE_COMPOSE_SHA256; expected_image=$CONTROL_ACTOR_CANDIDATE_IMAGE ;;
    "$EXPECTED_RETRY_BUDGET_CANDIDATE_BACKUP_SHA256") expected_compose=$RETRY_BUDGET_CANDIDATE_COMPOSE_SHA256; expected_image=$RETRY_BUDGET_CANDIDATE_IMAGE ;;
    "$EXPECTED_RESUME_LINEAGE_CANDIDATE_BACKUP_SHA256") expected_compose=$RESUME_LINEAGE_CANDIDATE_COMPOSE_SHA256; expected_image=$RESUME_LINEAGE_CANDIDATE_IMAGE ;;
    "$EXPECTED_RESUME_DISPATCH_CANDIDATE_BACKUP_SHA256") expected_compose=$RESUME_DISPATCH_CANDIDATE_COMPOSE_SHA256; expected_image=$RESUME_DISPATCH_CANDIDATE_IMAGE ;;
    "$EXPECTED_RESUME_DISPATCH_R2_CANDIDATE_BACKUP_SHA256") expected_compose=$RESUME_DISPATCH_R2_CANDIDATE_COMPOSE_SHA256; expected_image=$RESUME_DISPATCH_R2_CANDIDATE_IMAGE ;;
    "$EXPECTED_RESUME_BRANCH_CANDIDATE_BACKUP_SHA256") expected_compose=$RESUME_BRANCH_CANDIDATE_COMPOSE_SHA256; expected_image=$RESUME_BRANCH_CANDIDATE_IMAGE ;;
    "$EXPECTED_KANBAN_NOTIFY_CANDIDATE_BACKUP_SHA256") expected_compose=$KANBAN_NOTIFY_CANDIDATE_COMPOSE_SHA256; expected_image=$KANBAN_NOTIFY_CANDIDATE_IMAGE ;;
    "$REVIEW_R9_CANDIDATE_BACKUP_SHA256") expected_compose=$REVIEW_R9_CANDIDATE_COMPOSE_SHA256; expected_image=$REVIEW_R9_CANDIDATE_IMAGE ;;
    "$UAT_R4FIX2_CANDIDATE_BACKUP_SHA256") expected_compose=$UAT_R4FIX2_CANDIDATE_COMPOSE_SHA256; expected_image=$UAT_R4FIX2_CANDIDATE_IMAGE ;;
    "$SHARE_ASSETFIX_CANDIDATE_BACKUP_SHA256") expected_compose=$SHARE_ASSETFIX_CANDIDATE_COMPOSE_SHA256; expected_image=$SHARE_ASSETFIX_CANDIDATE_IMAGE ;;
    "$SHARE_ORIGINFIX_CANDIDATE_BACKUP_SHA256") expected_compose=$SHARE_ORIGINFIX_CANDIDATE_COMPOSE_SHA256; expected_image=$SHARE_ORIGINFIX_CANDIDATE_IMAGE ;;
    "$REVIEW_R10_CANDIDATE_BACKUP_SHA256") expected_compose=$REVIEW_R10_CANDIDATE_COMPOSE_SHA256; expected_image=$REVIEW_R10_CANDIDATE_IMAGE ;;
    "$REVIEW_R14_CANDIDATE_BACKUP_SHA256") expected_compose=$REVIEW_R14_CANDIDATE_COMPOSE_SHA256; expected_image=$REVIEW_R14_CANDIDATE_IMAGE ;;
    "$REVIEW_R15_CANDIDATE_BACKUP_SHA256") expected_compose=$REVIEW_R15_CANDIDATE_COMPOSE_SHA256; expected_image=$REVIEW_R15_CANDIDATE_IMAGE ;;
    "$REVIEW_R13_CANDIDATE_BACKUP_SHA256") expected_compose=$REVIEW_R13_CANDIDATE_COMPOSE_SHA256; expected_image=$REVIEW_R13_CANDIDATE_IMAGE ;;
    "$REVIEW_R12_CANDIDATE_BACKUP_SHA256") expected_compose=$REVIEW_R12_CANDIDATE_COMPOSE_SHA256; expected_image=$REVIEW_R12_CANDIDATE_IMAGE ;;
    "$REVIEW_R11_CANDIDATE_BACKUP_SHA256") expected_compose=$REVIEW_R11_CANDIDATE_COMPOSE_SHA256; expected_image=$REVIEW_R11_CANDIDATE_IMAGE ;;
    *) fail 'production backup wrapper is not the reviewed baseline or candidate wrapper' ;;
esac
[ -f "$VERIFIER" ] && [ ! -L "$VERIFIER" ] || fail 'strict verifier missing or symlinked'
[ "$(sha256sum "$VERIFIER" | awk '{print $1}')" = "$EXPECTED_VERIFIER_SHA256" ] || fail 'strict verifier hash mismatch'
[ -d "$OUTBOX_ROOT" ] && [ ! -L "$OUTBOX_ROOT" ] || fail 'encrypted outbox missing or symlinked'
before=$(find "$OUTBOX_ROOT" -maxdepth 1 -type f -name 'kaneo-*.receipt.json' -printf '%f\n' | sort | tail -n 1 || true)
sh "$PROJECT_BACKUP" --snapshot --yes
latest=$(find "$OUTBOX_ROOT" -maxdepth 1 -type f -name 'kaneo-*.receipt.json' -printf '%f\n' | sort | tail -n 1 || true)
[ -n "$latest" ] || fail 'snapshot did not produce a receipt'
[ "$latest" != "$before" ] || fail 'snapshot did not advance the receipt head'
backup_id=${latest%.receipt.json}
printf '%s\n' "$backup_id" | grep -Eq '^kaneo-[0-9]{8}T[0-9]{6}Z$' || fail 'snapshot backup id is invalid'
cipher="$OUTBOX_ROOT/$backup_id.age"
receipt="$OUTBOX_ROOT/$latest"
[ -f "$cipher" ] && [ ! -L "$cipher" ] || fail 'new ciphertext missing or symlinked'
[ -f "$receipt" ] && [ ! -L "$receipt" ] || fail 'new receipt missing or symlinked'
verify_dir=$(mktemp -d "$OUTBOX_ROOT/.verify.XXXXXX")
cleanup() { rm -rf "$verify_dir"; }
trap cleanup EXIT HUP INT TERM
ln "$cipher" "$verify_dir/$backup_id.age"
ln "$receipt" "$verify_dir/$latest"
python3 "$VERIFIER" "$verify_dir" --json >/dev/null || fail 'strict new-bundle verification failed'
python3 - "$receipt" "$expected_compose" "$expected_image" <<'PY'
import json
import sys

path, expected_compose, expected_image = sys.argv[1:]
with open(path, encoding="utf-8") as handle:
    receipt = json.load(handle)
if (receipt.get("compose_sha256"), receipt.get("image_ref")) != (expected_compose, expected_image):
    raise SystemExit("receipt source identity does not match the staged wrapper")
if receipt.get("inner_manifest_decrypt_verified") is not False:
    raise SystemExit("receipt is not pre-decrypt")
if receipt.get("plaintext_egress") is not False:
    raise SystemExit("plaintext egress policy mismatch")
PY
cipher_sha256=$(sha256sum "$cipher" | awk '{print $1}')
receipt_sha256=$(sha256sum "$receipt" | awk '{print $1}')
printf '%s\n' "Kaneo current backup PASS: $backup_id ciphertext_sha256=$cipher_sha256 receipt_sha256=$receipt_sha256 (local encrypted outbox; R2 mirror remains separate)."
