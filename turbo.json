{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"KANEO_API_URL",
		"KANEO_PUBLIC_API_URL",
		"KANEO_INTERNAL_API_URL"
	],
	"globalPassThroughEnv": [
		"DATABASE_URL",
		"GITHUB_PRIVATE_KEY",
		"GITHUB_PRIVATE_KEY_BASE64",
		"KANEO_CLIENT_URL",
		"REDIS_CLUSTER_NODES",
		"REDIS_PASSWORD",
		"REDIS_SENTINELS",
		"REDIS_SENTINEL_MASTER_NAME",
		"REDIS_SENTINEL_PASSWORD",
		"REDIS_SENTINEL_TLS",
		"REDIS_URL",
		"S3_ACCESS_KEY_ID",
		"S3_BUCKET",
		"S3_ENDPOINT",
		"S3_FORCE_PATH_STYLE",
		"S3_KEY_PREFIX",
		"S3_MAX_IMAGE_UPLOAD_BYTES",
		"S3_REGION",
		"S3_SECRET_ACCESS_KEY",
		"TURNSTILE_SECRET_KEY"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},

		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		},
		"test:integration": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		}
	}
}
