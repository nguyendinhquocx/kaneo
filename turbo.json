{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"KANEO_API_URL",
		"KANEO_PUBLIC_API_URL",
		"KANEO_INTERNAL_API_URL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},

		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		},
		"test:integration": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		}
	}
}
