#!/bin/sh
# Fixed read-only Kaneo migration-head and schema verifier — child-activity-context-r1 wave pins (SPEC-2026-11-25 UI agent binding @ 03cc5a71 (polish r3)).
# SQL is static and SELECT-only; this adapter never runs migrations or writes data.
set -eu

PROJECT_DIR=/srv/kaneo
COMPOSE_FILE=$PROJECT_DIR/compose.yml
EXPECTED_COMPOSE_SHA256=18432de3d979f85230479ea7e71110a9a6027e96b4aefa82cf78629f9a2705ed
EXPECTED_IMAGE='ghcr.io/nguyendinhquocx/kaneo-vi-mcp:2.14.0-candidate-ce629fe1-ui-agent-polish-r3@sha256:c4e4e4b6c9cfcaa79ae2c27c00c280d4dd881563ccd67f2594006cf2235afb2e'
EXPECTED_HEAD_ID=60
EXPECTED_HEAD_HASH=e03ce7c2eac9e8448c632d2d0ede0a8add655824aa8c73e1d11043e3f67104fa
EXPECTED_MIGRATION_COUNT=60
EXPECTED_REQUIRED_COLUMNS=70
EXPECTED_REQUIRED_CONSTRAINTS=7

fail() { printf '%s\n' "Kaneo migration verify BLOCKED: $*" >&2; exit 2; }
[ "$#" -eq 0 ] || fail 'no arguments are accepted'
[ "$(id -u)" -eq 0 ] || fail 'root execution required'
[ -f "$COMPOSE_FILE" ] && [ ! -L "$COMPOSE_FILE" ] || fail 'candidate Compose missing or symlinked'
[ "$(sha256sum "$COMPOSE_FILE" | awk '{print $1}')" = "$EXPECTED_COMPOSE_SHA256" ] || fail 'candidate Compose hash mismatch'
[ "$(docker inspect --format '{{.Config.Image}}' kaneo 2>/dev/null || true)" = "$EXPECTED_IMAGE" ] || fail 'running Kaneo image is not the candidate'
(cd "$PROJECT_DIR" && docker compose config --quiet)
docker compose -f "$COMPOSE_FILE" ps --status running --services | grep -Fxq postgres || fail 'postgres is not running'

run_sql() {
    sql=$1
    docker compose -f "$COMPOSE_FILE" exec -T postgres sh -c 'exec psql -X -v ON_ERROR_STOP=1 -qAt -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "$1"' sh "$sql"
}

head_row=$(run_sql "SELECT id::text || '|' || hash FROM drizzle.__drizzle_migrations ORDER BY id DESC LIMIT 1;") || fail 'could not read Drizzle migration head'
IFS='|' read -r head_id head_hash <<EOF2
$head_row
EOF2
[ "$head_id" = "$EXPECTED_HEAD_ID" ] || fail "unexpected migration head id: $head_id"
[ "$head_hash" = "$EXPECTED_HEAD_HASH" ] || fail "unexpected migration head hash: $head_hash"
migration_count=$(run_sql "SELECT count(*)::text FROM drizzle.__drizzle_migrations;") || fail 'could not count Drizzle migrations'
[ "$migration_count" = "$EXPECTED_MIGRATION_COUNT" ] || fail "unexpected migration count: $migration_count"
required_columns=$(run_sql "WITH expected(table_name, column_name) AS (VALUES ('mcp_oauth_state','id'),('mcp_oauth_state','kind'),('mcp_oauth_state','key'),('mcp_oauth_state','payload'),('mcp_oauth_state','expires_at'),('mcp_oauth_state','created_at'),('mcp_oauth_state','updated_at'),('apikey','reference_id'),('workspace_member','user_id'),('session','active_organization_id'),('invitation','created_at'),('execution_flag','name'),('execution_flag','enabled'),('execution_flag','updated_at'),('github_integration','id'),('github_integration','project_id'),('github_integration','repository_owner'),('github_integration','repository_name'),('github_integration','installation_id'),('github_integration','is_active'),('github_integration','created_at'),('github_integration','updated_at'),('task_run','last_progress_at'),('task','work_marker_counts'),('project','show_subtask_cards_by_default'),('project','show_assignees_by_default'),('project','show_priority_by_default'),('workspace_integration_settings','workspace_id'),('workspace_integration_settings','mitra_enabled'),('workspace_integration_settings','wisemapping_enabled'),('workspace_integration_settings','created_at'),('workspace_integration_settings','updated_at'),('task','content_revision'),('agent_session_binding','id'),('agent_session_binding','task_id'),('agent_session_binding','project_id'),('agent_session_binding','agent_principal_id'),('agent_session_binding','host_id'),('agent_session_binding','session_id'),('agent_session_binding','binding_generation'),('agent_session_binding','status'),('agent_session_binding','last_heartbeat_at'),('agent_session_binding','revoked_at'),('agent_session_binding','revoked_reason'),('agent_session_binding','created_at'),('agent_session_binding','updated_at'),('agent_session_binding','revision'),('agent_session_delivery','id'),('agent_session_delivery','binding_id'),('agent_session_delivery','task_id'),('agent_session_delivery','client_action_key'),('agent_session_delivery','comment_id'),('agent_session_delivery','comment_updated_at'),('agent_session_delivery','comment_content_hash'),('agent_session_delivery','state'),('agent_session_delivery','claimed_at'),('agent_session_delivery','claimed_lease_expires_at'),('agent_session_delivery','enqueued_at'),('agent_session_delivery','expires_at'),('agent_session_delivery','created_at'),('agent_session_delivery','updated_at'),('agent_session_delivery','binding_generation'),('agent_session_presence','session_id'),('agent_session_presence','agent_principal_id'),('agent_session_presence','host'),('agent_session_presence','title'),('agent_session_presence','cwd'),('agent_session_presence','model'),('agent_session_presence','first_seen_at'),('agent_session_presence','last_seen_at')) SELECT count(*)::text FROM expected WHERE EXISTS (SELECT 1 FROM information_schema.columns c WHERE c.table_schema='public' AND c.table_name=expected.table_name AND c.column_name=expected.column_name);") || fail 'could not inspect required schema columns'
[ "$required_columns" = "$EXPECTED_REQUIRED_COLUMNS" ] || fail "required schema columns present: $required_columns/$EXPECTED_REQUIRED_COLUMNS"
required_constraints=$(run_sql "SELECT count(*)::text FROM pg_constraint c JOIN pg_class t ON t.oid = c.conrelid JOIN pg_namespace n ON n.oid = t.relnamespace WHERE n.nspname='public' AND t.relname IN ('github_integration','agent_session_binding','agent_session_delivery') AND c.conname IN ('github_integration_project_id_unique','github_integration_project_id_project_id_fk','agent_session_binding_task_id_task_id_fk','agent_session_binding_project_id_project_id_fk','agent_session_binding_agent_principal_id_agent_principal_id_fk','agent_session_delivery_binding_id_agent_session_binding_id_fk','agent_session_delivery_action_key_unique');") || fail 'could not inspect GitHub compatibility constraints'
[ "$required_constraints" = "$EXPECTED_REQUIRED_CONSTRAINTS" ] || fail "GitHub compatibility constraints present: $required_constraints/$EXPECTED_REQUIRED_CONSTRAINTS"
required_integration_fk=$(run_sql "SELECT count(*)::text FROM pg_constraint c JOIN pg_class t ON t.oid = c.conrelid WHERE t.relname='workspace_integration_settings' AND c.contype='f' AND c.conname='workspace_integration_settings_workspace_id_workspace_id_fk';") || fail 'could not inspect workspace integration FK'
[ "$required_integration_fk" = "1" ] || fail "workspace integration FK present: $required_integration_fk/1"
backfill_gaps=$(run_sql "SELECT count(*)::text FROM integration i WHERE i.type='github' AND NULLIF(i.config::jsonb ->> 'repositoryOwner', '') IS NOT NULL AND NULLIF(i.config::jsonb ->> 'repositoryName', '') IS NOT NULL AND NOT EXISTS (SELECT 1 FROM github_integration g WHERE g.project_id=i.project_id);") || fail 'could not verify GitHub compatibility backfill'
[ "$backfill_gaps" = "0" ] || fail "GitHub compatibility backfill gaps: $backfill_gaps"
project_default_gaps=$(run_sql "SELECT count(*)::text FROM project WHERE show_subtask_cards_by_default IS NULL OR show_assignees_by_default IS NULL OR show_priority_by_default IS NULL;") || fail 'could not verify project display-default backfill'
[ "$project_default_gaps" = "0" ] || fail "project display-default backfill gaps: $project_default_gaps"
marker_counts_valid=$(run_sql "SELECT count(*)::text FROM task WHERE work_marker_counts IS NULL OR (SELECT count(*) FROM jsonb_each(work_marker_counts)) <> 4 OR EXISTS (SELECT 1 FROM jsonb_each(work_marker_counts) e WHERE e.key NOT IN ('redCross','boxedRedCross','redCircle','greenCheck') OR jsonb_typeof(e.value) <> 'number' OR e.value #>> '{}' !~ '^[0-9]+$' OR (e.value #>> '{}')::int > 99);") || fail 'could not verify work marker counts shape'
[ "$marker_counts_valid" = "0" ] || fail "work marker counts outside the reviewed shape: $marker_counts_valid"
required_indexes=$(run_sql "SELECT count(*)::text FROM pg_indexes WHERE schemaname='public' AND indexname IN ('agent_session_binding_active_task_unique','agent_session_binding_active_session_unique','agent_session_binding_principal_idx','agent_session_binding_session_idx','agent_session_delivery_state_idx','agent_session_presence_last_seen_idx');") || fail 'could not inspect agent-session indexes'
[ "$required_indexes" = "6" ] || fail "agent-session indexes present: $required_indexes/5"
printf '%s\n' "Kaneo migration/schema PASS: head=0056_agent_session_delivery_generation id=$head_id migrations=$migration_count hash=$head_hash required_columns=$required_columns/$EXPECTED_REQUIRED_COLUMNS named_constraints=$required_constraints/$EXPECTED_REQUIRED_CONSTRAINTS agent_session_indexes=$required_indexes/5 integration_fk=$required_integration_fk backfill_gaps=$backfill_gaps project_default_gaps=$project_default_gaps marker_counts_valid=$marker_counts_valid (read-only)"
